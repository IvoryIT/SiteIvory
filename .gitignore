# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migração / capturas locais
/.tmp/
/.playwright-mcp/

# configuração pessoal do Claude Code
.claude/settings.local.json

# nunca versionar: credenciais, dumps e restos do WordPress (skill varredura-segredos-pre-commit)
*.key
*.p12
*.pfx
*.sql
*.sql.gz
*.zip
*.bak
*.bk
*.old
wp-config*.php
**/wp-content/updraft/
**/wp-content/uploads/wpforms/
**/wp-content/uploads/complianz/
**/wp-content/wflogs/
